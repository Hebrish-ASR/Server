# sherpa-onnx int8 on the CPU: the apps' engine and model files. Small image, no torch.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml ./
COPY hebrish_server ./hebrish_server
RUN uv pip install --system --no-cache .
ENV HEBRISH_HOST=0.0.0.0 HEBRISH_MODELS_DIR=/models HEBRISH_ENGINE=sherpa
EXPOSE 8870
CMD ["python", "-m", "hebrish_server"]
